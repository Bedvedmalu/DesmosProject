           <property name="styleSheet">
            <string notr="true">
/* Карточка функции */
QFrame#functionRow {
    background-color: #2B3039;
    border: 1px solid #343D49;
    border-radius: 9px;
}

QFrame#functionRow:hover {
    border-color: #455162;
}

QFrame#functionRow QLabel { color: #CBD5E1; background: transparent; border: none; }

/* Шесть точек */
QToolButton#functionDrag {
    background: transparent;
    border: none;
    padding: 0px;
}

/* Галочка видимости */
QToolButton#functionVisibility {
    background-color: #202936;
    color: transparent;
    border: 1px solid #46546A;
    border-radius: 6px;
    font-size: 19px;
    font-weight: bold;
    padding: 0px;
}

QToolButton#functionVisibility:checked {
    background-color: #2D83F5;
    border: 1px solid #2879E5;
    color: white;
}

/* Поле ввода выражения */
QLineEdit#functionExpression {
    background-color: #191F28;
    color: #E9EDF4;
    border: 2px solid #424F60;
    border-radius: 7px;
    padding: 4px 11px;
    font-family: &quot;Segoe UI&quot;;
    font-size: 16px;
    selection-background-color: #347BF5;
}

QLineEdit#functionExpression:focus {
    border-color: #64748B;
}

/* Кнопка удаления */
QToolButton#functionRemove {
    background: transparent;
    color: #C8CDD5;
    border: none;
    font-family: &quot;Segoe UI&quot;;
    font-size: 27px;
    padding: 0px;
}

QToolButton#functionRemove:hover {
    color: #F05262;
}
</string>
