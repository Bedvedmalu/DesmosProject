  <property name="styleSheet">
   <string>/* Graphing Calculator — dark Qt Widgets form */
QMainWindow { background: #171C24; color: #F1F5F9; }
QWidget#centralwidget { background: #171C24; }
QWidget#functionPanel { background: #1E2530; border: none; }
QLabel#label { background: transparent; color: #F1F5F9; font-size: 18px; font-weight: 700; }
QToolBar { background: #252D39; border: 0; border-bottom: 1px solid #394454; padding: 7px; spacing: 8px; }
QToolBar QToolButton { background: transparent; color: #F1F5F9; padding: 8px 11px; border: 0; border-radius: 6px; font-size: 13px; }
QToolBar QToolButton:hover { background: #364254; }
QToolBar QToolButton:pressed { background: #3478F6; }
QToolBar::separator { background: #465367; width: 1px; margin: 5px 8px; }
QToolButton#addButton, QToolButton#deleteButton { background: #303A49; color: #F1F5F9; border: 1px solid #465367; border-radius: 6px; padding: 5px; min-width: 24px; min-height: 24px; }
QToolButton#addButton:hover { background: #3478F6; border-color: #3478F6; }
QToolButton#deleteButton:hover { background: #B83B4B; border-color: #B83B4B; }
QScrollArea#scrollArea, QWidget#scrollAreaWidgetContents { background: #1E2530; border: none; }
QFrame[functionRow=&quot;true&quot;] { background: #2B3442; border: 1px solid #394454; border-radius: 8px; }
QFrame[functionRow=&quot;true&quot;] QLabel { color: #94A3B8; background: transparent; border: none; }
QFrame[functionRow=&quot;true&quot;] QLineEdit { background: #19212C; color: #F1F5F9; border: 1px solid #465367; border-radius: 5px; padding: 7px; font-size: 14px; }
QFrame[functionRow=&quot;true&quot;] QLineEdit:focus { border-color: #3478F6; }
QFrame[functionRow=&quot;true&quot;] QCheckBox { background: transparent; border: none; }
QFrame[functionRow=&quot;true&quot;] QToolButton { color: #F1F5F9; background: transparent; border: none; border-radius: 5px; font-size: 18px; }
QFrame[functionRow=&quot;true&quot;] QToolButton:hover { background: #B83B4B; }
QScrollBar:vertical { background: #1E2530; width: 9px; border: none; margin: 0; }
QScrollBar::handle:vertical { background: #465367; min-height: 24px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #64748B; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QSplitter::handle:horizontal { background: #394454; width: 5px; }
QSplitter::handle:horizontal:hover { background: #3478F6; }
QWidget#graphCanvas { background: #111923; border: none; }
QWidget#bottomBar { background: #252D39; border-top: 1px solid #394454; }
QWidget#bottomBar QLabel { background: transparent; color: #DCE4EF; border: none; font-size: 12px; }
QMenuBar { background: #252D39; color: #F1F5F9; }
QMenuBar::item:selected { background: #364254; }
QStatusBar { background: #252D39; color: #F1F5F9; }</string>
